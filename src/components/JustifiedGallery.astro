---
interface Props {
  photos: {
    src: string;
    width: number;
    height: number;
    alt: string;
  }[];
}

const { photos } = Astro.props;

function getCloudflareUrl(src: string, width = 1600) {
  if (import.meta.env.PROD) {
    return `/cdn-cgi/image/width=${width},format=auto,quality=80${src}`;
  }
  return src;
}
---

<div class="gallery-grid">
  {photos.map((photo) => {
    // Calculate the aspect ratio (e.g., 4000/6000 = 0.66, 6000/4000 = 1.5)
    const ratio = photo.width / photo.height;
    
    return (
      <a 
        href={photo.src} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="gallery-item"
        style={`--ratio: ${ratio}`}
      >
        <img
          src={getCloudflareUrl(photo.src)}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading="lazy"
          class="gallery-img"
        />
      </a>
    );
  })}
</div>

<style>
  /* ─── Mobile: 1 Column, Full Width, No Crop ─────────── */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .gallery-item {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--soft, #1a1a1a);
  }

  .gallery-img {
    width: 100%;
    height: auto; /* Natural height, no cropping */
    display: block;
    transition: opacity 0.2s ease;
  }

  /* ─── Desktop/Tablet: Justified Rows, No Crop ───────── */
  @media (min-width: 768px) {
    .gallery-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    
    .gallery-item {
      /* 
        1. flex-grow based on the ratio ensures all images in a row 
           perfectly share the height.
        2. flex-basis determines when to wrap to the next row.
      */
      flex-grow: var(--ratio);
      flex-basis: calc(var(--ratio) * 350px);
      min-width: calc(var(--ratio) * 150px); 
    }

    /* 
      This invisible element absorbs the extra width on the last row 
      so the final images don't stretch to fill the whole screen.
    */
    .gallery-grid::after {
      content: "";
      flex-grow: 100000;
    }
  }

  .gallery-item:hover .gallery-img {
    opacity: 0.85;
  }
</style>