---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getPublishedWriting, getPublishedCollection, projectPath, workPath, byOrder } from '../lib/content';
import { site } from '../data/site';
import { sitePath } from '../lib/urls';
import Icon from '../components/chrome/Icon.astro';

const writing = await getPublishedWriting();
const recent = writing.slice(0, 4);

const allProjects = byOrder(await getPublishedCollection('projects'));
const featured =
  allProjects.find((entry) => entry.data.featured) ?? allProjects[0];
const others = allProjects
  .filter((entry) => entry.id !== featured?.id)
  .slice(0, 3);

const roles = byOrder(await getPublishedCollection('work')).slice(0, 3);

const base = import.meta.env.BASE_URL;
const asset = (p?: string) => (p ? `${base}${p.replace(/^\//, '')}` : undefined);

const heroImage = asset(featured?.data.heroImage as string | undefined);
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Mechanical Engineering Student</p>
    <h1>{site.name}</h1>
    <p class="lede">{site.author.edu}</p>
    <p class="author">{site.author.bio}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={sitePath('/projects/')}>View projects</a>
      <a class="btn" href={sitePath('/Marcus_Yoo_Resume_Two_Page.pdf')}>Resume (PDF)</a>
      <a class="btn" href={sitePath('/about/')}>About me</a>
    </div>
    <p class="avail">Looking for Spring/Summer 2027 mechanical engineering internships and co-ops.</p>
  </section>

  {featured && (
    <section class="container featured">
      <div class="section-heading">
        <h2><span>01 /</span> Featured</h2>
        <a href={sitePath('/projects/')}>
          All projects <Icon name="arrowRight" size="sm" />
        </a>
      </div>
      <a class="feature-card" href={projectPath(featured)}>
        {heroImage && (
          <div class="feature-media">
            <img
              src={heroImage}
              alt={featured.data.title}
              loading="eager"
              style={featured.data.heroPosition
                ? `object-position: ${featured.data.heroPosition}`
                : undefined}
            />
          </div>
        )}
        <div class="feature-body">
          <p class="eyebrow">{featured.data.type} · {featured.data.status}</p>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.description}</p>
          {featured.data.tags?.length > 0 && (
            <ul class="tag-row">
              {featured.data.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
            </ul>
          )}
          <span class="read-more">Read the full story →</span>
        </div>
      </a>
    </section>
  )}

  {others.length > 0 && (
    <section class="container">
      <div class="section-heading">
        <h2><span>02 /</span> Selected work</h2>
        <a href={sitePath('/projects/')}>
          All projects <Icon name="arrowRight" size="sm" />
        </a>
      </div>
      <div class="project-grid">
        {others.map((entry) => (
          <a class="project-card" href={projectPath(entry)}>
            {entry.data.heroImage && (
              <div class="card-media">
                <img
                  src={asset(entry.data.heroImage)}
                  alt={entry.data.title}
                  loading="lazy"
                  style={entry.data.heroPosition
                    ? `object-position: ${entry.data.heroPosition}`
                    : undefined}
                />
              </div>
            )}
            <div class="card-body">
              <div class="card-head">
                <p class="eyebrow">{entry.data.type}</p>
                {entry.data.status && (
                  <span class={`status status-${entry.data.status}`}>
                    {entry.data.status}
                  </span>
                )}
              </div>
              <h3>{entry.data.title}</h3>
              <p class="card-desc">{entry.data.description}</p>
              {entry.data.tags?.length > 0 && (
                <ul class="tag-row">
                  {entry.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {recent.length > 0 && (
    <section class="container">
      <div class="section-heading">
        <h2><span>03 /</span> Writing</h2>
        <a href={sitePath('/writing/')}>
          All {writing.length} posts <Icon name="arrowRight" size="sm" />
        </a>
      </div>
      <div class="list">
        {recent.map((entry) => <PostCard entry={entry} />)}
      </div>
    </section>
  )}

  {roles.length > 0 && (
    <section class="container cv-section">
      <div class="section-heading">
        <h2><span>04 /</span> Experience</h2>
        <a href={sitePath('/work/')}>
          All work <Icon name="arrowRight" size="sm" />
        </a>
      </div>
      <div class="cv-cards">
        {roles.map((role) => (
          <a class="cv-card" href={workPath(role)}>
            <p class="cv-eyebrow">{role.data.company}</p>
            <h3>{role.data.role}</h3>
            <p class="cv-desc">{role.data.description}</p>
            <span class="cv-cta">Read more →</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero { padding: clamp(4rem, 10vw, 9rem) 0 5rem; }
  .hero h1 {
    font-size: clamp(3rem, 12vw, 8rem);
    line-height: .9;
    margin: .5rem 0 1.5rem;
    letter-spacing: -.06em;
  }
  .lede {
    font-size: clamp(1.2rem, 2.4vw, 1.75rem);
    max-width: 45rem;
    line-height: 1.3;
  }
  .author { color: var(--muted); max-width: 40rem; margin-top: .5rem; }
  .avail {
    font-family: ui-monospace, monospace;
    font-size: .8125rem;
    color: var(--accent);
    margin-top: 1.75rem;
    letter-spacing: .02em;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: .625rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: .9375rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms, background 120ms;
  }
  .btn:hover { border-color: currentColor; }
  .btn-primary {
    background: var(--fg, #f5f5f5);
    color: var(--bg, #0a0a0a);
    border-color: var(--fg, #f5f5f5);
    font-weight: 500;
  }
  .btn-primary:hover { opacity: .88; border-color: var(--fg, #f5f5f5); }

  .section-heading span {
    color: var(--accent);
    font-size: .8rem;
    font-family: ui-monospace, monospace;
  }
  section + section { margin-top: 4rem; }

  /* ─── Featured card ────────────────────────────────── */
  .feature-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 150ms, transform 150ms;
  }
  .feature-card:hover {
    border-color: currentColor;
    transform: translateY(-2px);
  }
  .feature-media {
    width: 100%;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    background: var(--soft, #f5f5f5);
  }
  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .feature-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }
  .feature-body h3 {
    font-size: 1.75rem;
    margin: 0;
    letter-spacing: -.01em;
  }
  .feature-body p { margin: 0; line-height: 1.6; }
  .read-more {
    margin-top: 1rem;
    font-size: .875rem;
    color: var(--muted);
  }

  /* ─── Selected work grid ───────────────────────────── */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 150ms, transform 150ms;
  }
  .project-card:hover {
    border-color: currentColor;
    transform: translateY(-2px);
  }

  .card-media {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    background: var(--soft, #f5f5f5);
    box-sizing: border-box;
  }
  .card-media img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-card:hover .card-media img {
    transform: scale(1.03);
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .5rem;
  }
  .card-head .eyebrow { margin: 0; }
  .card-body h3 {
    font-size: 1.15rem;
    margin: 0;
    letter-spacing: -.005em;
  }
  .card-desc {
    margin: 0;
    font-size: .9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .status {
    font-family: ui-monospace, monospace;
    font-size: .6875rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    padding: .125rem .5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
  }
  .status-active { color: #15803d; }
  .status-maintained { color: #2563eb; }
  .status-paused { color: #b45309; }
  .status-archived { color: var(--muted); }

  .tag-row {
    list-style: none;
    padding: 0;
    margin: .5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: .375rem;
  }
  .tag-row li {
    font-size: .75rem;
    padding: .125rem .5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    background: transparent;
    line-height: 1.6;
  }

  /* ─── Experience / CV cards ────────────────────────── */
  .cv-section {
  padding-bottom: 2rem;
}
  .cv-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .cv-card {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms, transform 150ms;
  }
  .cv-card:hover {
    border-color: currentColor;
    transform: translateY(-2px);
  }
  .cv-eyebrow {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: .6875rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cv-card h3 {
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: -.01em;
  }
  .cv-desc {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
    font-size: .9375rem;
  }
  .cv-cta {
    margin-top: auto;
    padding-top: 1rem;
    font-size: .875rem;
    color: var(--muted);
    font-family: ui-monospace, monospace;
  }
  .cv-card:hover .cv-cta { color: var(--accent); }

  @media (prefers-color-scheme: dark) {
    .status-active { color: #4ade80; }
    .status-maintained { color: #60a5fa; }
    .status-paused { color: #fbbf24; }
  }
  @media (max-width: 960px) {
    .project-grid { grid-template-columns: repeat(2, 1fr); }
    .cv-cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 42rem) {
    .hero { padding-top: 4rem; }
    .project-grid { grid-template-columns: 1fr; }
    .cv-cards { grid-template-columns: 1fr; }
  }
</style>