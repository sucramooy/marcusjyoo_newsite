---
import fs from 'node:fs';
import path from 'node:path';
import { imageSize } from 'image-size';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JustifiedGallery from '../../components/JustifiedGallery.astro';

export async function getStaticPaths() {
  const photographyDir = path.join(process.cwd(), 'public', 'images', 'photography');
  
  if (!fs.existsSync(photographyDir)) return [];

  const folders = fs.readdirSync(photographyDir, { withFileTypes: true })
    .filter((dirent) => dirent.isDirectory())
    .map((dirent) => dirent.name);

  return folders.map((folder) => {
    // If folder is "_secret", the URL slug becomes "secret"
    const slug = folder.startsWith('_') ? folder.slice(1) : folder;
    return {
      params: { album: slug },
      props: { folderName: folder }, // Keep the real folder name for the images
    };
  });
}

const { folderName } = Astro.props;
const isPrivate = folderName.startsWith('_');

const albumDir = path.join(process.cwd(), 'public', 'images', 'photography', folderName);

const files = fs.readdirSync(albumDir)
  .filter((file) => /\.(jpe?g|png|webp)$/i.test(file))
  .sort();

const photos = files.map((file) => {
  const filePath = path.join(albumDir, file);
  const dimensions = imageSize(fs.readFileSync(filePath));
  
  return {
    // Uses folderName (with underscore) so the image paths resolve correctly
    src: `/images/photography/${folderName}/${file}`,
    width: dimensions.width || 4000,
    height: dimensions.height || 6000,
    alt: file.replace(/\.[^/.]+$/, ""),
  };
});

// Strip the underscore before formatting the title
const titleSource = folderName.startsWith('_') ? folderName.slice(1) : folderName;
const cleanTitle = titleSource.replace(/-/g, '/').replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
const title = cleanTitle.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

const siteUrl = import.meta.env.SITE_URL || 'https://marcusjyoo.com';
let ogImage = undefined;

if (photos.length > 0) {
  const firstPhoto = photos[0].src;
  
  ogImage = import.meta.env.PROD
    ? `${siteUrl}/cdn-cgi/image/width=1200,format=jpeg,quality=80${firstPhoto}`
    : `${siteUrl}${firstPhoto}`;
}
---

<BaseLayout 
  title={title} 
  image={ogImage}
  description={`A photography album by Marcus J. Yoo featuring ${photos.length} frames.`}
>
  <!-- Prevent search engines from indexing private albums -->
  {isPrivate && <meta name="robots" content="noindex, nofollow" />}

  <article class="container album-container">
    <header class="album-header">
      <p class="eyebrow">{isPrivate ? 'Private Album' : 'Photography'}</p>
      <h1 class="huge-title">{title}</h1>
      <p class="meta">{photos.length} frames</p>
    </header>
    
    <JustifiedGallery photos={photos} />
  </article>
</BaseLayout>

<style>
  .album-container {
    padding-top: 5rem;
    padding-bottom: 5rem;
    margin: 0 auto;
  }
  
  .album-header {
    margin-bottom: 3rem;
  }
  
  .huge-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem) !important;
    line-height: .95 !important;
    letter-spacing: -.05em !important;
    margin: .5rem 0 1rem !important;
  }
  
  .meta {
    font-family: ui-monospace, monospace;
    font-size: .75rem;
    color: var(--muted);
    text-transform: uppercase;
  }
</style>