---
import fs from 'node:fs';
import path from 'node:path';
import { imageSize } from 'image-size';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JustifiedGallery from '../../components/JustifiedGallery.astro';

export async function getStaticPaths() {
  const photographyDir = path.join(process.cwd(), 'public', 'images', 'photography');
  
  if (!fs.existsSync(photographyDir)) return [];

  const folders = fs.readdirSync(photographyDir, { withFileTypes: true })
    .filter((dirent) => dirent.isDirectory())
    .map((dirent) => dirent.name);

  return folders.map((folder) => ({
    params: { album: folder },
    props: { album: folder },
  }));
}

const { album } = Astro.props;
const albumDir = path.join(process.cwd(), 'public', 'images', 'photography', album);

const files = fs.readdirSync(albumDir)
  .filter((file) => /\.(jpe?g|png|webp)$/i.test(file))
  .sort();

const photos = files.map((file) => {
  const filePath = path.join(albumDir, file);
  const dimensions = imageSize(fs.readFileSync(filePath));
  
  return {
    src: `/images/photography/${album}/${file}`,
    width: dimensions.width || 4000,
    height: dimensions.height || 6000,
    alt: file.replace(/\.[^/.]+$/, ""),
  };
});

const cleanTitle = album.replace(/-/g, '/').replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
const title = cleanTitle.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

const siteUrl = import.meta.env.SITE_URL || 'https://marcusjyoo.com';
let ogImage = undefined;

if (photos.length > 0) {
  const firstPhoto = photos[0].src;
  
  // Force a 1200px wide JPEG for maximum compatibility with iMessage/WhatsApp
  ogImage = import.meta.env.PROD
    ? `${siteUrl}/cdn-cgi/image/width=1200,format=jpeg,quality=80${firstPhoto}`
    : `${siteUrl}${firstPhoto}`;
}
---

<BaseLayout 
  title={title} 
  image={ogImage}
  description={`A photography album by Marcus J. Yoo featuring ${photos.length} frames.`}
>
  <!-- Added "container" class here to match the rest of the site -->
  <article class="container album-container">
    <header class="album-header">
      <p class="eyebrow">Photography</p>
      <h1 class="huge-title">{title}</h1>
      <p class="meta">{photos.length} frames</p>
    </header>
    
    <JustifiedGallery photos={photos} />
  </article>
</BaseLayout>

<style>
  /* Removed the max-width so it inherits the theme's standard width */
  .album-container {
    padding-top: 5rem;
    padding-bottom: 5rem;
    margin: 0 auto;
  }
  
  .album-header {
    margin-bottom: 3rem;
  }
  
  .huge-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem) !important;
    line-height: .95 !important;
    letter-spacing: -.05em !important;
    margin: .5rem 0 1rem !important;
  }
  
  .meta {
    font-family: ui-monospace, monospace;
    font-size: .75rem;
    color: var(--muted);
    text-transform: uppercase;
  }
</style>