---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const instagram = site.social.find((s) => s.label.toLowerCase() === 'instagram');

const photographyDir = path.join(process.cwd(), 'public', 'images', 'photography');
const albums = fs.existsSync(photographyDir) 
  ? fs.readdirSync(photographyDir, { withFileTypes: true })
      .filter((d) => d.isDirectory())
      .map((d) => d.name)
  : [];

const albumData = albums.map(album => {
  const albumDir = path.join(photographyDir, album);
  const files = fs.readdirSync(albumDir).filter(f => /\.(jpe?g|png|webp)$/i.test(f));
  
  // Format "House-Boulders_10-25" to "House/Boulders 10/25"
  const cleanTitle = album.replace(/-/g, '/').replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
  const title = cleanTitle.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

  return {
    slug: album,
    title: title,
    cover: files.length > 0 ? `/images/photography/${album}/${files[0]}` : null
  };
});

const getCoverUrl = (cover: string) => {
  if (import.meta.env.PROD) {
    return `/cdn-cgi/image/height=1200,format=auto,quality=80${cover}`;
  }
  return cover;
};
---

<BaseLayout
  title="Photography · Marcus J. Yoo"
  description="Film photography and visual work by Marcus J. Yoo."
>
  <header class="page-head container">
    <p class="eyebrow">Photography</p>
    <h1 class="huge-title">35mm.</h1>
    
    {albumData.length > 0 ? (
      <p class="intro">
        A collection of film and digital photography.
      </p>
    ) : (
      <p class="intro">
        Have a look at my Instagram:
      </p>
    )}

    {instagram && (
      <p class="link">
        <a href={instagram.href} target="_blank" rel="noopener">
          {instagram.href.replace(/^https?:\/\/(www\.)?/, '')}
        </a>
      </p>
    )}
  </header>

  {albumData.length > 0 && (
    <section class="container album-grid">
      {albumData.map((album) => (
        <a href={`/photos/${album.slug}/`} class="album-card">
          
          <div class="album-media">
            {album.cover ? (
              <img 
                src={getCoverUrl(album.cover)} 
                alt={album.title} 
                loading="lazy"
              />
            ) : (
              <span class="placeholder">No images</span>
            )}
          </div>

          <h2>{album.title}</h2>
        </a>
      ))}
    </section>
  )}
</BaseLayout>

<style>
  .page-head { padding: 5rem 0 3rem; }
  
  .huge-title {
    font-size: clamp(3rem, 8vw, 6rem) !important;
    line-height: .95 !important;
    letter-spacing: -.05em !important;
    max-width: 50rem;
    margin: .5rem 0 1.5rem !important;
  }

  .intro {
    color: var(--muted);
    max-width: 40rem;
    line-height: 1.6;
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }
  .link a {
    font-size: 1.125rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── Album Grid ────────────────────────────────────── */
  .album-grid {
    display: grid;
    grid-template-columns: 1fr; /* Mobile */
    gap: 2rem;
    padding-bottom: 5rem;
  }

  @media (min-width: 768px) {
    .album-grid {
      grid-template-columns: repeat(2, 1fr); /* Tablet: 2 cols */
    }
  }

  @media (min-width: 1024px) {
    .album-grid {
      grid-template-columns: repeat(3, 1fr); /* Desktop: 3 cols */
    }
  }

  .album-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 250ms;
  }
  .album-card:hover {
    transform: translateY(-2px);
  }

  /* Vertical 2:3 aspect ratio for album covers */
  .album-media {
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--soft, #1a1a1a);
    overflow: hidden;
    transition: border-color 150ms;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .album-card:hover .album-media {
    border-color: currentColor;
  }

  .album-media img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Crops only the album cover to make it perfectly vertical */
    display: block;
  }

  .placeholder {
    font-family: ui-monospace, monospace;
    font-size: .75rem;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0.5;
  }

  .album-card h2 {
    margin: 1rem 0 0;
    font-size: 1.25rem;
    letter-spacing: -.01em;
  }
</style>