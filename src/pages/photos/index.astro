---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const instagram = site.social.find((s) => s.label.toLowerCase() === 'instagram');
---

<BaseLayout
  title="Photography · Marcus J. Yoo"
  description="Film photography and visual work by Marcus J. Yoo."
>
  <header class="page-head container">
    <p class="eyebrow">Photography</p>
    <h1>35mm.</h1>
    <p class="intro">
      I wasn't able to add my art and photography to this page yet. For now,
      have a look at my Instagram:
    </p>
    {instagram && (
      <p class="link">
        <a href={instagram.href} target="_blank" rel="noopener">
          {instagram.href.replace(/^https?:\/\/(www\.)?/, '')}
        </a>
      </p>
    )}
  </header>
</BaseLayout>

<style>
  .page-head { padding: 5rem 0; }
  .page-head h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .95;
    letter-spacing: -.05em;
    max-width: 50rem;
    margin: .5rem 0 1rem;
  }
  .intro {
    color: var(--muted);
    max-width: 40rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .link a {
    font-size: 1.125rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>