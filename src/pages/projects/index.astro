---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedCollection, projectPath, byOrder } from '../../lib/content';

const projects = byOrder(await getPublishedCollection('projects'));

const base = import.meta.env.BASE_URL;
const asset = (p?: string) => (p ? `${base}${p.replace(/^\//, '')}` : undefined);
---

<BaseLayout
  title="Projects"
  description="Selected mechanical engineering projects by Marcus J. Yoo."
>
  <header class="page-head container">
    <p class="eyebrow">Projects</p>
    <h1>Things I've built lately.</h1>
    <p class="intro">
      Mechanical design, fabrication, and product development — sliderules,
      snowskates, and rocket fin assemblies.
    </p>
  </header>

  <section class="container list">
    {projects.map((entry) => (
      <article class="project">
        <div class="project-text">
          <p class="eyebrow">
            {entry.data.status} · {entry.data.type}
          </p>
          <h2><a href={projectPath(entry)}>{entry.data.title}</a></h2>
          <p class="desc">{entry.data.description}</p>
          {entry.data.tags?.length > 0 && (
            <ul class="tag-row">
              {entry.data.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </div>

        <a class="project-media" href={projectPath(entry)}>
          {entry.data.heroImage ? (
            <img
              src={asset(entry.data.heroImage)}
              alt={entry.data.title}
              loading="lazy"
              style={entry.data.heroPosition
                ? `object-position: ${entry.data.heroPosition}`
                : undefined}
            />
          ) : (
            <span class="placeholder">No image</span>
          )}
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-head { padding: 5rem 0 3rem; }
  .page-head h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .95;
    letter-spacing: -.05em;
    max-width: 50rem;
    margin: .5rem 0 1rem;
  }
  .intro {
    color: var(--muted);
    max-width: 40rem;
    line-height: 1.6;
    margin: 0;
  }

  .list {
    display: flex;
    flex-direction: column;
    padding-bottom: 5rem;
  }

  .project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }

  .project-text {
    display: flex;
    flex-direction: column;
  }
  .project-text .eyebrow { margin: 0 0 .3rem; }
  .project-text h2 {
    margin: 0 0 .75rem;
    font-size: 1.7rem;
    letter-spacing: -.01em;
  }
  .project-text h2 a {
    color: inherit;
    text-decoration: none;
  }
  .project-text h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .project-text .desc {
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  .tag-row {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: .375rem;
  }
  .tag-row li {
    font-size: .75rem;
    padding: .125rem .5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    background: transparent;
    line-height: 1.6;
  }

  .project-media {
    display: block;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--soft, #f5f5f5);
    transition: border-color 150ms;
  }
  .project-media:hover {
    border-color: currentColor;
  }
  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms;
  }
  .project-media:hover img {
    transform: scale(1.03);
  }
  .project-media .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: ui-monospace, monospace;
    font-size: .75rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: .5;
  }

  @media (max-width: 42rem) {
    .project {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .project-media {
      order: -1;
    }
  }
</style>