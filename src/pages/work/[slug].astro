---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedCollection } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedCollection('work');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^.*\//, '').replace(/\.(md|mdx)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<BaseLayout
  title={`${entry.data.title} · Marcus J. Yoo`}
  description={entry.data.description}
>
  <article class="article narrow">
    <p class="eyebrow">
      {entry.data.role} · {entry.data.company}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="dates">
      {fmt(entry.data.startDate)}
      {entry.data.endDate ? ` — ${fmt(entry.data.endDate)}` : ' — Present'}
      {entry.data.location ? ` · ${entry.data.location}` : ''}
    </p>
    <p class="dek">{entry.data.description}</p>

    {entry.data.tags?.length > 0 && (
      <ul class="tag-row">
        {entry.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}

    <div class="prose"><Content /></div>
    
  </article>
</BaseLayout>

<style>
  .article { padding: 5rem 0; }
  .article h1 {
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -.05em;
    margin: .5rem 0;
  }
  .dates {
    font-family: ui-monospace, monospace;
    font-size: .875rem;
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .dek { font-size: 1.2rem; color: var(--muted); line-height: 1.4; }
  .tag-row {
    list-style: none; padding: 0; margin: 1.25rem 0 0;
    display: flex; flex-wrap: wrap; gap: .375rem;
  }
  .tag-row li {
    font-size: .75rem; padding: .125rem .5rem;
    border-radius: 999px; background: var(--surface, #f5f5f5);
    color: var(--muted);
  }
</style>