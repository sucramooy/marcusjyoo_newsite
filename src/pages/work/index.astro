---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedCollection, workPath, byOrder } from '../../lib/content';

const entries = byOrder(await getPublishedCollection('work'));

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<BaseLayout
  title="Work · Marcus J. Yoo"
  description="Internships and roles — engineering work outside the classroom."
>
  <header class="page-head container">
    <p class="eyebrow">Work Experience</p>
    <h1>My work experience.</h1>
    <p class="intro">Internships and roles outside the classroom.</p>
  </header>

  <section class="container list">
    {entries.map((entry) => (
      <article class="job">
        <div class="job-head">
          <p class="eyebrow">
            {entry.data.company}
          </p>
          <h2><a href={workPath(entry)}>{entry.data.title}</a></h2>
          <p class="dates">
            {fmt(entry.data.startDate)}
            {entry.data.endDate ? ` — ${fmt(entry.data.endDate)}` : ' — Present'}
            {entry.data.location ? ` · ${entry.data.location}` : ''}
          </p>
        </div>
        <p class="desc">{entry.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-head { padding: 5rem 0 3rem; }
  .page-head h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .95;
    letter-spacing: -.05em;
    margin: .5rem 0 1rem;
  }
  .intro { color: var(--muted); max-width: 40rem; line-height: 1.6; margin: 0; }

  .job {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .job h2 { margin: .3rem 0; font-size: 1.5rem; }
  .job h2 a { color: inherit; text-decoration: none; }
  .job h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .dates {
    font-family: ui-monospace, monospace;
    font-size: .8125rem;
    color: var(--muted);
    margin: 0;
  }
  .desc { color: var(--muted); margin: 0; line-height: 1.6; }

  @media (max-width: 42rem) {
    .job { grid-template-columns: 1fr; gap: .5rem; }
  }
</style>