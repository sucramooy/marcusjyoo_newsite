{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "default": "zh-cn",
      "type": "string",
      "enum": [
        "zh-cn",
        "en"
      ]
    },
    "translationKey": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "seoTitle": {
      "type": "string"
    },
    "canonical": {
      "type": "string",
      "format": "uri"
    },
    "ogImage": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "default": "note",
      "type": "string"
    },
    "version": {
      "default": "0.1",
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paperUrl": {
      "type": "string",
      "format": "uri"
    },
    "codeUrl": {
      "type": "string",
      "format": "uri"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "publishedAt"
  ]
}