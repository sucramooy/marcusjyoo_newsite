{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "cover": {
      "type": "string"
    },
    "private": {
      "default": false,
      "type": "boolean"
    },
    "photos": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "width",
          "height",
          "alt"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "cover"
  ]
}