{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "default": "zh-cn",
      "type": "string",
      "enum": [
        "zh-cn",
        "en"
      ]
    },
    "translationKey": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "seoTitle": {
      "type": "string"
    },
    "canonical": {
      "type": "string",
      "format": "uri"
    },
    "ogImage": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "group": {
      "default": "常读",
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "url"
  ]
}